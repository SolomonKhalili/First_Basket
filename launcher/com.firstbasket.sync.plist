<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the NBA folder up to date with the cloud copy: runs sync_from_cloud.py at login and every minute.
     Installed as ~/Library/LaunchAgents/com.firstbasket.sync.plist. To turn it off:
       launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.firstbasket.sync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.firstbasket.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3.14</string>
    <string>/Users/solomonkhalili/Desktop/NBA/sync_from_cloud.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/solomonkhalili/Desktop/NBA</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/firstbasket-sync.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/firstbasket-sync.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
